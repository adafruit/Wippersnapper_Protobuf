# uart.options
wippersnapper.uart.Add.device_id                   max_size: 32
wippersnapper.uart.DeviceConfig.device_id          max_size: 32
wippersnapper.uart.Added.device_id                 max_size: 32
wippersnapper.uart.Remove.device_id                max_size: 32
wippersnapper.uart.Write.device_id                 max_size: 32
wippersnapper.uart.Written.device_id               max_size: 32
wippersnapper.uart.SerialConfig.pin_rx             max_size: 16
wippersnapper.uart.SerialConfig.pin_tx             max_size: 16
wippersnapper.uart.GenericInputConfig.sensor_types max_count:15
wippersnapper.uart.PM25AQIConfig.sensor_types      max_count:15
wippersnapper.uart.InputEvent.device_id            max_size: 16
wippersnapper.uart.InputEvent.events               max_count:15
