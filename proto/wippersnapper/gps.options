wippersnapper.gps.Config.commands_ubxes      max_size:128
wippersnapper.gps.Config.commands_ubxes      max_count:8
wippersnapper.gps.RMCResponse.fix_status     max_size:2
wippersnapper.gps.RMCResponse.lat            max_size:12
wippersnapper.gps.RMCResponse.lat_dir        max_size:6
wippersnapper.gps.RMCResponse.lon            max_size:12
wippersnapper.gps.RMCResponse.lon_dir        max_size:6
wippersnapper.gps.RMCResponse.speed          max_size:8
wippersnapper.gps.RMCResponse.angle          max_size:7
wippersnapper.gps.GPGGAResponse.lat          max_size:12
wippersnapper.gps.GPGGAResponse.lat_dir      max_size:6
wippersnapper.gps.GPGGAResponse.lon          max_size:12
wippersnapper.gps.GPGGAResponse.lon_dir      max_size:6
wippersnapper.gps.GPGGAResponse.hdop         max_size:6
wippersnapper.gps.GPGGAResponse.altitude     max_size:8
wippersnapper.gps.GPGGAResponse.geoid_height max_size:10
wippersnapper.gps.Event.rmc_responses        max_count:10
wippersnapper.gps.Event.gga_responses        max_count:10
