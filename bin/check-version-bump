#!/usr/bin/env python3
"""Keep us honest about bumping VERSION.

If a change touches any .proto or .options file under proto/ in a way that
isn't purely whitespace, VERSION must be strictly greater (by semver) than the
VERSION currently on the base branch. VERSION may never go backwards.

Usage:
  bin/check-version-bump [BASE_REF] [HEAD_REF]
    BASE_REF  branch to compare against   (default: origin/api-v2)
    HEAD_REF  commit under test           (default: HEAD)

  bin/check-version-bump --self-test

Changes are measured from merge-base(BASE_REF, HEAD_REF) to HEAD_REF, i.e. only
what this branch changed. The version is compared against the *tip* of
BASE_REF, so a PR that's gone stale behind a newer bump on the base is caught.
"""

import re
import subprocess
import sys

VERSION_FILE = "VERSION"
WATCHED_PATHSPECS = [":(glob)proto/**/*.proto", ":(glob)proto/**/*.options"]

# https://semver.org/#is-there-a-suggested-regular-expression-regex-to-check-a-semver-string
SEMVER_RE = re.compile(
    r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"
    r"(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)"
    r"(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?"
    r"(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$"
)


# --- semver -----------------------------------------------------------------

def parse_semver(text):
    m = SEMVER_RE.match(text)
    if not m:
        raise ValueError(f"not a valid semver string: {text!r}")
    core = tuple(int(x) for x in m.group(1, 2, 3))
    pre = m.group(4)
    return core, (pre.split(".") if pre else None)


def _cmp_ident(a, b):
    a_num, b_num = a.isdigit(), b.isdigit()
    if a_num and b_num:
        return (int(a) > int(b)) - (int(a) < int(b))
    if a_num != b_num:
        return -1 if a_num else 1  # numeric identifiers sort before alphanumeric
    return (a > b) - (a < b)


def compare_semver(a, b):
    """-1/0/1, per semver precedence rules (build metadata ignored)."""
    (ca, pa), (cb, pb) = parse_semver(a), parse_semver(b)
    if ca != cb:
        return (ca > cb) - (ca < cb)
    if pa is None or pb is None:
        # a version without pre-release outranks one with it
        return (pa is None) - (pb is None)
    for x, y in zip(pa, pb):
        c = _cmp_ident(x, y)
        if c:
            return c
    return (len(pa) > len(pb)) - (len(pa) < len(pb))


# --- git --------------------------------------------------------------------

def git(*args, check=True):
    res = subprocess.run(["git", *args], capture_output=True, text=True,
                         encoding="utf-8")
    if check and res.returncode != 0:
        sys.exit(f"git {' '.join(args)} failed:\n{res.stderr.strip()}")
    return res


def show(ref, path):
    """File contents at ref, or None if it doesn't exist there."""
    res = git("show", f"{ref}:{path}", check=False)
    return res.stdout if res.returncode == 0 else None


def normalize(text):
    """Drop whitespace differences: trim lines, collapse runs, drop blanks."""
    if text is None:
        return None
    lines = (" ".join(line.split()) for line in text.splitlines())
    return [line for line in lines if line]


def read_version(ref):
    text = show(ref, VERSION_FILE)
    return None if text is None else text.strip()


# --- check ------------------------------------------------------------------

def check(base_ref, head_ref):
    base_version = read_version(base_ref)
    if base_version is None:
        print(f"{base_ref} has no {VERSION_FILE} file; nothing to check.")
        return 0

    head_version = read_version(head_ref)
    if head_version is None:
        print(f"::error::{VERSION_FILE} is missing on {head_ref} but exists "
              f"on {base_ref} ({base_version}).")
        return 1

    try:
        parse_semver(head_version)
    except ValueError as e:
        print(f"::error file={VERSION_FILE}::{e}")
        return 1
    try:
        parse_semver(base_version)
    except ValueError:
        print(f"::warning::{VERSION_FILE} on {base_ref} isn't valid semver "
              f"({base_version!r}); only checking the PR's version format.")
        return 0

    merge_base = git("merge-base", base_ref, head_ref).stdout.strip()
    changed = git("diff", "--name-only", "--no-renames", merge_base, head_ref,
                  "--", *WATCHED_PATHSPECS).stdout.split()
    significant = [p for p in changed
                   if normalize(show(merge_base, p)) != normalize(show(head_ref, p))]

    cmp = compare_semver(head_version, base_version)
    print(f"base ({base_ref}) VERSION: {base_version}")
    print(f"this branch     VERSION: {head_version}")

    if cmp < 0:
        print(f"::error file={VERSION_FILE}::VERSION went backwards: "
              f"{head_version} < {base_version} on {base_ref}.")
        return 1

    if not significant:
        skipped = len(changed)
        note = f" ({skipped} whitespace-only)" if skipped else ""
        print(f"No .proto/.options changes{note}; no version bump required.")
        return 0

    print("Changed .proto/.options files (ignoring whitespace):")
    for p in significant:
        print(f"  {p}")

    if cmp == 0:
        print(f"::error file={VERSION_FILE}::Proto/options files changed but "
              f"VERSION is still {head_version} (same as {base_ref}). Bump it "
              f"(e.g. the pre-release number, or patch/minor/major as "
              f"appropriate). If {base_ref} was bumped since you branched, "
              f"merge it in and bump past it.")
        return 1

    print(f"OK: VERSION bumped {base_version} -> {head_version}.")
    return 0


def self_test():
    order = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta",
             "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0",
             "2.0.0-alpha.0", "2.0.0-alpha.1", "2.0.0-alpha.2",
             "2.0.0-alpha.10", "2.0.0-beta", "2.0.0-rc.1", "2.0.0", "2.0.1",
             "2.1.0", "10.0.0"]
    for i, a in enumerate(order):
        for j, b in enumerate(order):
            want = (i > j) - (i < j)
            got = compare_semver(a, b)
            assert got == want, f"compare({a}, {b}) = {got}, want {want}"
    assert compare_semver("1.0.0+build.1", "1.0.0+build.2") == 0
    for bad in ["2.0", "v2.0.0", "2.0.0-", "02.0.0", "2.0.0-alpha..1", ""]:
        try:
            parse_semver(bad)
        except ValueError:
            continue
        raise AssertionError(f"accepted invalid semver {bad!r}")
    assert normalize("a  b\n\n\t c \r\n") == normalize("a b\nc") == ["a b", "c"]
    assert normalize(None) is None and normalize("") == []
    print("self-test OK")
    return 0


def main(argv):
    if argv[1:2] == ["--self-test"]:
        return self_test()
    if argv[1:2] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    base_ref = argv[1] if len(argv) > 1 else "origin/api-v2"
    head_ref = argv[2] if len(argv) > 2 else "HEAD"
    return check(base_ref, head_ref)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
