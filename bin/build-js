#!/usr/bin/env bash

# vars
: ${OUT_PATH=js_out}

# move to the directory above this file
cd "${0%/*}/.."

# include helpful functions
source "./bin/functions.sh"

clean
activate_mise
ensure protoc

# put buf on the path and invoke protoc
PATH=$PATH:$(pwd)/node_modules/.bin \
    protoc \
    --proto_path=./proto/wippersnapper \
    --es_out $OUT_PATH \
    --es_opt target=js+dts \
    --es_opt js_import_style=legacy_commonjs \
    ./proto/wippersnapper/*.proto

completed_message "JavaScript"
